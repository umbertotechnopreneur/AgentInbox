<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the desktop's configuration-only logic without a WinUI or Windows runtime. -->
    <Compile Include="../../src/MailMeUp.Desktop/Services/CodexSetupModels.cs" Link="Desktop/CodexSetupModels.cs" />
    <Compile Include="../../src/MailMeUp.Desktop/Services/CodexSetupPresentation.cs" Link="Desktop/CodexSetupPresentation.cs" />
    <Compile Include="../../src/MailMeUp.Desktop/Services/CodexSetupService.cs" Link="Desktop/CodexSetupService.cs" />
    <Compile Include="../../src/MailMeUp.Desktop/Services/DemoMailMeUpApplication.cs" Link="Desktop/DemoMailMeUpApplication.cs" />
    <Compile Include="../../src/MailMeUp.Desktop/Services/SetupLaunchOptions.cs" Link="Desktop/SetupLaunchOptions.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MailMeUp.Application/MailMeUp.Application.csproj" />
    <ProjectReference Include="../../src/MailMeUp.Cli/MailMeUp.Cli.csproj" />
    <ProjectReference Include="../../src/MailMeUp.Mcp/MailMeUp.Mcp.csproj" />
    <ProjectReference Include="../../src/MailMeUp.Storage/MailMeUp.Storage.csproj" />
    <ProjectReference Include="../../src/MailMeUp.Providers.Google/MailMeUp.Providers.Google.csproj" />
    <ProjectReference Include="../../src/MailMeUp.Providers.Microsoft/MailMeUp.Providers.Microsoft.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
</Project>
