<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.0.1</Version>
    <Product>AgentInbox</Product>
    <Title>AgentInbox</Title>
    <Authors>Umberto Giacobbi</Authors>
    <Copyright>Copyright (c) 2026 Umberto Giacobbi</Copyright>
    <RepositoryUrl>https://github.com/umbertotechnopreneur/AgentInbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MailMeUpPortableBuild)' == 'true'">
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)eng/locks/$(MailMeUpPortableRuntime)/$(MSBuildProjectName).json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
