  <ItemGroup>
    <InternalsVisibleTo Include="MailMeUp.Tests" />
    <ProjectReference Include="../MailMeUp.Hosting/MailMeUp.Hosting.csproj" />
    <ProjectReference Include="../MailMeUp.Application/MailMeUp.Application.csproj" />
    <ProjectReference Include="../MailMeUp.Storage/MailMeUp.Storage.csproj" />
    <ProjectReference Include="../MailMeUp.Security/MailMeUp.Security.csproj" />
    <ProjectReference Include="../MailMeUp.Providers.Google/MailMeUp.Providers.Google.csproj" />
    <ProjectReference Include="../MailMeUp.Providers.Microsoft/MailMeUp.Providers.Microsoft.csproj" />
    <ProjectReference Include="../MailMeUp.Mcp/MailMeUp.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\resources\vibeware-symbol.rgb" LogicalName="MailMeUp.Cli.Assets.vibeware-symbol.rgb" />
