<Application
    x:Class="MailMeUp.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#115C63" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D9115C63" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B8115C63" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#71DEB7" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D971DEB7" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B871DEB7" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#071525" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#D9071525" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Each page gets its own native control and resources; dictionaries cannot be reparented. -->
            <DataTemplate x:Key="AccountTabsTemplate">
                <TabView IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
                         TabWidthMode="SizeToContent" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                    <TabView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#405850" />
                                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="White" />
                                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#71DEB7" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#DCEFE9" />
                                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#14342F" />
                                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#115C63" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource SystemColorWindowColor}" />
                                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <x:Double x:Key="TabViewItemMinHeight">44</x:Double>
                            <x:Double x:Key="TabViewItemHeaderFontSize">15</x:Double>
                            <Thickness x:Key="TabViewItemHeaderPaddingWithoutCloseButton">16,10,16,10</Thickness>
                            <Thickness x:Key="TabViewSelectedItemBorderThickness">1,1,1,0</Thickness>
                        </ResourceDictionary>
                    </TabView.Resources>
                </TabView>
            </DataTemplate>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="21" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SubtleText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
