<ContentDialog
    x:Class="MailMeUp.Desktop.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About &amp; Support"
    CloseButtonText="Close"
    DefaultButton="Close">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
            <Border CornerRadius="12" Background="#071525">
                <Grid Height="172">
                    <Image Source="Assets/AboutBanner.png" Stretch="UniformToFill"
                           AutomationProperties.Name="Envelopes and a calendar coming together into one conversation" />
                    <StackPanel VerticalAlignment="Center" Margin="22" Spacing="6" Width="190" HorizontalAlignment="Left">
                        <TextBlock Text="AgentInbox" FontSize="30" FontWeight="SemiBold" Foreground="#F5EADB" />
                        <TextBlock Text="All your inboxes.&#x0a;One conversation." FontSize="15" Foreground="#F5EADB" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Spacing="5">
                <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                <TextBlock Text="Created by Umberto Giacobbi · MIT licensed" TextWrapping="Wrap" Opacity="0.75" />
                <TextBlock Text="A local, read-only bridge for your email, calendars and AI assistant." Style="{StaticResource BodyText}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <HyperlinkButton Content="umbertogiacobbi.biz" NavigateUri="https://umbertogiacobbi.biz/" Padding="0,6" />
                    <HyperlinkButton Content="GitHub repository" NavigateUri="https://github.com/umbertotechnopreneur/AgentInbox" Padding="0,6" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="Need help or found a bug?" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Get support in the project's GitHub repository. Describe what happened and include your app version." Style="{StaticResource BodyText}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton Content="Get support on GitHub" NavigateUri="https://github.com/umbertotechnopreneur/AgentInbox/issues" Padding="0,6" />
                    <Button Content="Copy app version" Click="CopyVersionButton_Click" />
                </StackPanel>
                <TextBlock x:Name="CopyStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Please keep email content and sign-in credentials out of public issues." FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            <Border Style="{StaticResource SetupCard}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Enjoying AgentInbox?" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Give it a star on GitHub. It helps other people discover the app." Style="{StaticResource BodyText}" />
                    <HyperlinkButton NavigateUri="https://github.com/umbertotechnopreneur/AgentInbox" Padding="0,6" AutomationProperties.Name="Star AgentInbox on GitHub">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE734;" FontSize="16" />
                            <TextBlock Text="Star AgentInbox on GitHub" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
