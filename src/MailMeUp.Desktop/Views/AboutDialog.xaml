<ContentDialog
    x:Class="MailMeUp.Desktop.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About AgentInbox"
    CloseButtonText="Close"
    DefaultButton="Close"
    RequestedTheme="Light"
    Background="{ThemeResource AboutSurface}"
    Foreground="{ThemeResource AboutInk}"
    FontFamily="Consolas">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AboutSurface" Color="#FFF4DC" />
                    <SolidColorBrush x:Key="AboutInk" Color="#232A2F" />
                    <SolidColorBrush x:Key="AboutSecondary" Color="#526573" />
                    <SolidColorBrush x:Key="AboutLink" Color="#3A6A96" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AboutSurface" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AboutInk" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AboutSecondary" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AboutLink" Color="{ThemeResource SystemColorHotlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
            <Style x:Key="AboutCopy" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource AboutInk}" />
            </Style>
            <Style x:Key="AboutFooterLink" TargetType="HyperlinkButton">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Foreground" Value="{ThemeResource AboutLink}" />
                <Setter Property="Padding" Value="4,6" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="AboutLinkIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="AboutLinkText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" Padding="0,6,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Image Source="ms-appx:///Assets/Logo.png" Width="64" Height="64" Stretch="Uniform"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="AgentInbox" Foreground="{ThemeResource AboutInk}" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                           VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            </StackPanel>
            <TextBlock Text="{x:Bind VersionLabel}" Style="{StaticResource AboutCopy}" Foreground="{ThemeResource AboutSecondary}" />
            <TextBlock Style="{StaticResource AboutCopy}"
                       Text="I built AgentInbox so your AI assistant can work across selected folders from your connected mailboxes through one MCP connection." />
            <TextBlock Style="{StaticResource AboutCopy}" Foreground="{ThemeResource AboutSecondary}"
                       Text="I maintain AgentInbox with help from contributors and take responsibility for what I ship." />
            <TextBlock Text="I'm Umberto Giacobbi · MIT" Style="{StaticResource AboutCopy}" />

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <HyperlinkButton NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" HorizontalAlignment="Center"
                                 AutomationProperties.Name="VibeWare manifesto" ToolTipService.ToolTip="Read the VibeWare manifesto.">
                    <Image Source="ms-appx:///Assets/VibeWare.png" Width="64" Height="64" Stretch="Uniform"
                           AutomationProperties.AccessibilityView="Raw" />
                </HyperlinkButton>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <HyperlinkButton Style="{StaticResource AboutFooterLink}" NavigateUri="https://umbertogiacobbi.biz/"
                                     AutomationProperties.Name="Umberto Giacobbi website" ToolTipService.ToolTip="Open Umberto Giacobbi's website.">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;" Style="{StaticResource AboutLinkIcon}" />
                            <TextBlock Grid.Column="1" Text="Website" Style="{StaticResource AboutLinkText}" />
                        </Grid>
                    </HyperlinkButton>
                    <HyperlinkButton Grid.Column="1" Style="{StaticResource AboutFooterLink}" NavigateUri="https://github.com/umbertotechnopreneur/AgentInbox"
                                     AutomationProperties.Name="AgentInbox source on GitHub" ToolTipService.ToolTip="Open the AgentInbox source repository.">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE943;" Style="{StaticResource AboutLinkIcon}" />
                            <TextBlock Grid.Column="1" Text="GitHub" Style="{StaticResource AboutLinkText}" />
                        </Grid>
                    </HyperlinkButton>
                    <HyperlinkButton Grid.Column="2" Style="{StaticResource AboutFooterLink}" NavigateUri="https://umbertogiacobbi.biz/agentinbox/terms/"
                                     AutomationProperties.Name="AgentInbox terms of use" ToolTipService.ToolTip="Read the AgentInbox terms of use.">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" Style="{StaticResource AboutLinkIcon}" />
                            <TextBlock Grid.Column="1" Text="Terms" Style="{StaticResource AboutLinkText}" />
                        </Grid>
                    </HyperlinkButton>
                    <HyperlinkButton Grid.Column="3" Style="{StaticResource AboutFooterLink}" NavigateUri="https://umbertogiacobbi.biz/agentinbox/privacy/"
                                     AutomationProperties.Name="AgentInbox privacy policy" ToolTipService.ToolTip="Read how AgentInbox handles your data.">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" Style="{StaticResource AboutLinkIcon}" />
                            <TextBlock Grid.Column="1" Text="Privacy" Style="{StaticResource AboutLinkText}" />
                        </Grid>
                    </HyperlinkButton>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
