<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MailMeUp.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AgentInbox">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="28,20" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Image Source="Assets/Logo.png" Width="42" Height="42" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="AgentInbox" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Your email. Standard connections. Your say before every send." Style="{StaticResource SubtleText}" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        OpenPaneLength="208" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Accounts" Tag="accounts" Icon="Mail" />
                <NavigationViewItem Content="Outgoing mail" Tag="outgoing" Icon="Send" />
                <NavigationViewItem Content="Connect assistant" Tag="assistant" Icon="Link" />
            </NavigationView.MenuItems>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Page" Padding="28,12,36,32" Spacing="20" MaxWidth="940" HorizontalAlignment="Left" />
            </ScrollViewer>
        </NavigationView>
        <StackPanel Grid.Row="2" Padding="28,8,28,16" Spacing="8">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
            <TextBlock Text="Built by Umberto Giacobbi · VibeWare · MIT" Style="{StaticResource SubtleText}" />
        </StackPanel>
    </Grid>
</Window>
