<Window
    x:Class="MailMeUp.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AgentInbox">
    <Grid x:Name="Root" Background="{ThemeResource SetupSurfaceBrush}" Loaded="Root_Loaded">
        <Grid.Resources>
            <DataTemplate x:Key="AccountListTemplate">
                <Grid ColumnSpacing="10" Padding="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE715;" FontSize="24" Opacity="0.55" AutomationProperties.AccessibilityView="Raw" />
                        <Image Width="32" Height="32" AutomationProperties.AccessibilityView="Raw" ImageFailed="ProviderLogo_Failed" ImageOpened="ProviderLogo_Opened">
                            <Image.Source><BitmapImage UriSource="{Binding ProviderLogo}" /></Image.Source>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Email}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" IsEnabled="{Binding HasCheckResult}" Click="AccountCheckDetails_Click"
                            Style="{StaticResource QuietButton}" Padding="4" VerticalAlignment="Center"
                            AutomationProperties.Name="Show account check details" ToolTipService.ToolTip="{Binding CheckDescription}">
                        <FontIcon Glyph="{Binding CheckGlyph}" DataContextChanged="AccountStatus_DataContextChanged" FontSize="18"
                                  AutomationProperties.Name="{Binding CheckDescription}" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="28,20" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Image Source="Assets/Logo.png" Width="42" Height="42" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="AgentInbox" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="All your mailboxes. One AI assistant via MCP." TextWrapping="Wrap" Style="{StaticResource SubtleText}" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        OpenPaneLength="208" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Accounts" Tag="accounts" ToolTipService.ToolTip="Create or edit your email accounts.">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Mail" Foreground="#16856A" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Connect Codex" Tag="assistant" ToolTipService.ToolTip="Connect your email accounts to Codex.">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Link" Foreground="#8B62CF" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                <StackPanel x:Name="Page" Padding="28,12,36,32" Spacing="20" MaxWidth="1040"
                            Width="{Binding ViewportWidth, ElementName=PageScroll, Mode=OneWay}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <Border x:Name="SaveBar" Grid.Row="1" Padding="28,14,28,14" Visibility="Collapsed"
                        BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel x:Name="PageActions" Orientation="Horizontal" Spacing="12" />
                </Border>
            </Grid>
        </NavigationView>
        <StackPanel Grid.Row="2" Padding="28,4,28,6" Spacing="4">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <Grid x:Name="BrandFooter" ColumnSpacing="16" RowSpacing="4" SizeChanged="BrandFooter_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="FooterLinks" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <HyperlinkButton NavigateUri="https://umbertogiacobbi.biz/" Padding="0,2" MinHeight="28"
                                     AutomationProperties.Name="Umberto Giacobbi website" ToolTipService.ToolTip="Open Umberto Giacobbi's website.">
                        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="UmbertoGiacobbi.Biz" /><FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    </HyperlinkButton>
                    <HyperlinkButton NavigateUri="https://umbertogiacobbi.biz/agentinbox/terms/" Padding="6,2" MinHeight="28"
                                     AutomationProperties.Name="AgentInbox terms of use" ToolTipService.ToolTip="Read the AgentInbox terms of use.">
                        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Terms" /><FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    </HyperlinkButton>
                    <HyperlinkButton NavigateUri="https://umbertogiacobbi.biz/agentinbox/privacy/" Padding="6,2" MinHeight="28"
                                     AutomationProperties.Name="AgentInbox privacy policy" ToolTipService.ToolTip="Read how AgentInbox handles your data.">
                        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Privacy" /><FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <HyperlinkButton x:Name="VibeWareLink" Grid.Column="1" NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" Padding="0"
                                 HorizontalAlignment="Right" AutomationProperties.Name="AgentInbox participates in VibeWare. Read the manifesto."
                                 ToolTipService.ToolTip="Created with AI under Umberto Giacobbi's direction and responsibility. Read the VibeWare manifesto.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="This is VibeWare" />
                            <TextBlock Text="Manifesto" />
                        </StackPanel>
                        <Image Source="Assets/VibeWare.png" Width="48" Height="48" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </HyperlinkButton>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
