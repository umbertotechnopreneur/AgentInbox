<Window
    x:Class="MailMeUp.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MailMeUp">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent" Padding="24,0,144,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/Logo.png" Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="MailMeUp" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid x:Name="RailLayout" Padding="14,16,14,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="RailTagline" Text="All your inboxes.&#x0a;One conversation." Style="{StaticResource BodyText}" Margin="12,0,0,24" />
                <Grid Grid.Row="1">
                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Left" Margin="25,26,0,26" IsHitTestVisible="False" />
                    <Border x:Name="ProgressLine" Width="2" Height="0" Background="{ThemeResource WizardAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,26,0,0" IsHitTestVisible="False" />
                    <ListBox x:Name="Steps" SelectionChanged="Steps_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource WizardStep}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Setup progress">
                        <ListBoxItem ToolTipService.ToolTip="Welcome"><StackPanel Orientation="Horizontal" Spacing="14"><Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Width="24" Height="24"><FontIcon x:Name="WelcomeIcon" Glyph="&#xE80F;" FontSize="18" /></Border><TextBlock x:Name="WelcomeLabel" Text="Welcome" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                        <ListBoxItem ToolTipService.ToolTip="Accounts"><StackPanel Orientation="Horizontal" Spacing="14"><Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Width="24" Height="24"><FontIcon x:Name="AccountsIcon" Glyph="&#xE77B;" FontSize="18" /></Border><TextBlock x:Name="AccountsLabel" Text="Accounts" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                        <ListBoxItem ToolTipService.ToolTip="Sharing"><StackPanel Orientation="Horizontal" Spacing="14"><Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Width="24" Height="24"><FontIcon x:Name="SharingIcon" Glyph="&#xE716;" FontSize="18" /></Border><TextBlock x:Name="SharingLabel" Text="Sharing" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                        <ListBoxItem ToolTipService.ToolTip="Connect to Codex"><StackPanel Orientation="Horizontal" Spacing="14"><Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Width="24" Height="24"><FontIcon x:Name="CodexIcon" Glyph="&#xE943;" FontSize="18" /></Border><TextBlock x:Name="CodexLabel" Text="Connect to Codex" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    </ListBox>
                </Grid>
                <Image x:Name="RailArtwork" Grid.Row="2" Source="Assets/WizardRail.png" Stretch="Uniform" MaxHeight="190" VerticalAlignment="Bottom" Margin="-8,16,-8,12" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Row="3" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,6" ToolTipService.ToolTip="Read-only by design"><FontIcon Glyph="&#xEA18;" FontSize="18" /><TextBlock x:Name="ReadOnlyLabel" Text="Read-only by design" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    <Button x:Name="PrivacyButton" Style="{StaticResource QuietButton}" Click="PrivacyButton_Click" AutomationProperties.Name="Privacy and terms" ToolTipService.ToolTip="Privacy &amp; terms"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE72E;" FontSize="16" /><TextBlock x:Name="PrivacyLabel" Text="Privacy &amp; terms" /></StackPanel></Button>
                    <Button x:Name="AboutButton" Style="{StaticResource QuietButton}" Click="AboutButton_Click" AutomationProperties.Name="About and support" ToolTipService.ToolTip="About &amp; support"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE946;" FontSize="16" /><TextBlock x:Name="AboutLabel" Text="About &amp; support" /></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="ContentLayout" Grid.Row="1" Grid.Column="1" Padding="32,16,32,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <InfoBar x:Name="DemoBanner" IsOpen="False" IsClosable="False" Severity="Informational" Title="UI preview" Message="Sample accounts only. Sign-in, provider reads and Codex changes are disabled; edits last for this preview session." Margin="0,0,0,16" />
            <!-- Ordinary pages fit the viewport; scrolling remains an accessibility fallback. -->
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageHost" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid x:Name="Pages" Margin="0,0,4,12">
                        <StackPanel x:Name="WelcomePage" Spacing="22">
                            <Grid x:Name="WelcomeHero" MinHeight="300">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HeroColumn" Width="0.9*" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="18">
                                    <TextBlock Text="LET'S GET YOU SET UP" FontSize="12" CharacterSpacing="120" Foreground="{ThemeResource WizardAccentBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WelcomeHeading" Text="Your inboxes.&#x0a;One conversation." FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Connect your mail and calendars to Codex. Choose the accounts and information you want to share." Style="{StaticResource BodyText}" MaxWidth="390" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Spacing="12"><Image Width="24" Height="24" AutomationProperties.Name="Google"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Google.svg" /></Image.Source></Image><Image Width="24" Height="24" AutomationProperties.Name="Microsoft"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Microsoft.svg" /></Image.Source></Image><TextBlock Text="Google &amp; Microsoft" VerticalAlignment="Center" FontSize="13" /></StackPanel>
                                </StackPanel>
                                <Image x:Name="WelcomeArtwork" Grid.Column="1" Source="Assets/WizardHero.png" MaxHeight="300" Stretch="Uniform" Margin="8,0,-8,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <Grid ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="WelcomeSharingColumn" Width="*" /><ColumnDefinition x:Name="WelcomeControlColumn" Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource SetupCard}" Padding="16"><StackPanel Spacing="8"><FontIcon Glyph="&#xE715;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource WizardAccentBrush}" /><TextBlock Text="Find what matters" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Search mail and see upcoming appointments." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                                <Border x:Name="WelcomeSharingCard" Grid.Column="1" Style="{StaticResource SetupCard}" Padding="16"><StackPanel Spacing="8"><FontIcon Glyph="&#xE716;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource WizardAccentBrush}" /><TextBlock Text="Choose what to share" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Personal, work and client accounts, together." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                                <Border x:Name="WelcomeControlCard" Grid.Column="2" Style="{StaticResource SetupCard}" Padding="16"><StackPanel Spacing="8"><FontIcon Glyph="&#xEA18;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource WizardAccentBrush}" /><TextBlock Text="Keep control" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Read-only access. Nothing sent or changed." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                            </Grid>
                            <StackPanel Spacing="8"><Button Style="{StaticResource QuietButton}" Click="SharingInfoButton_Click"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE76C;" FontSize="12" /><TextBlock Text="How sharing works" /></StackPanel></Button><TextBlock Text="Requested content may reach your AI service. Sign-in tokens stay on this device." Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="AccountsPage" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="6"><TextBlock Text="Connect your accounts" Style="{StaticResource SectionTitle}" /><TextBlock Text="Add personal, work or client accounts." Style="{StaticResource BodyText}" /></StackPanel>
                            <Grid x:Name="ProviderButtons" ColumnSpacing="12" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="MicrosoftProviderColumn" Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Button x:Name="GoogleButton" Click="GoogleButton_Click" HorizontalAlignment="Stretch" Padding="16,12" AutomationProperties.Name="Connect Google"><StackPanel Orientation="Horizontal" Spacing="12"><Image Width="24" Height="24" AutomationProperties.AccessibilityView="Raw"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Google.svg" /></Image.Source></Image><TextBlock Text="Connect Google" TextWrapping="Wrap" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button x:Name="MicrosoftButton" Grid.Column="1" Click="MicrosoftButton_Click" HorizontalAlignment="Stretch" Padding="16,12" AutomationProperties.Name="Connect Microsoft"><StackPanel Orientation="Horizontal" Spacing="12"><Image Width="24" Height="24" AutomationProperties.AccessibilityView="Raw"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Microsoft.svg" /></Image.Source></Image><TextBlock Text="Connect Microsoft" TextWrapping="Wrap" VerticalAlignment="Center" /></StackPanel></Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock x:Name="RequestAccessLabel" Text="Read access" VerticalAlignment="Center" /><CheckBox x:Name="RequestMail" Content="Mail" IsChecked="True" /><CheckBox x:Name="RequestCalendars" Content="Calendars" IsChecked="True" /></StackPanel>
                            <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="ProviderSetupButton_Click"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE713;" FontSize="20" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Provider setup" /><TextBlock x:Name="ProviderStatusText" Text="Loading provider setup…" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" /></Grid></Button>
                            <Border Style="{StaticResource SetupCard}" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid x:Name="ConnectedAccountsHeader" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="AccountCheckColumn" Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Spacing="3"><TextBlock Text="Connected on this device" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="AccountsCountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button x:Name="CheckConnectionsButton" Grid.Column="1" Click="CheckConnectionsButton_Click" Style="{StaticResource QuietButton}" Padding="12,6" VerticalAlignment="Center" AutomationProperties.Name="Check mail and calendar read access"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Check read access" /></StackPanel></Button></Grid>
                                    <StackPanel x:Name="ConnectedAccounts" Spacing="2" />
                                    <TextBlock Text="New accounts start with sharing off. Choose what to share in the next step." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="SharingPage" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="6"><TextBlock Text="Choose what to share" Style="{StaticResource SectionTitle}" /><TextBlock Text="Select an account, then choose what Codex can read." Style="{StaticResource BodyText}" /></StackPanel>
                            <Grid x:Name="SharingLayout" ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SharingListColumn" Width="0.85*" /><ColumnDefinition x:Name="SharingDetailColumn" Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="SharingListRegion" Spacing="10">
                                    <TextBlock Text="Your accounts" FontWeight="SemiBold" />
                                    <StackPanel x:Name="SharingAccounts" Spacing="4" />
                                </StackPanel>
                                <StackPanel x:Name="SharingDetailRegion" Grid.Column="1" Spacing="14">
                                    <Button x:Name="ChooseAccountButton" Content="← Choose account" Style="{StaticResource QuietButton}" Click="ChooseAccountButton_Click" Visibility="Collapsed" />
                                    <TextBlock x:Name="SharingEmptyText" Text="Connect an account to choose what to share." Style="{StaticResource BodyText}" />
                                    <Border x:Name="SharingEditorCard" Style="{StaticResource SetupCard}" Padding="18" Visibility="Collapsed"><StackPanel x:Name="SharingEditor" Spacing="14" Visibility="Collapsed">
                                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image x:Name="SelectedProviderLogo" Width="26" Height="26" AutomationProperties.AccessibilityView="Raw" /><TextBlock x:Name="SelectedAccountText" Grid.Column="1" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></Grid>
                                        <ToggleSwitch x:Name="ShareAccountSwitch" Header="Share this account" Toggled="SharingSwitch_Toggled" />
                                        <TextBlock x:Name="SharingOffText" Text="Turn on sharing to choose mail and calendars." Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="SharingCategories" Spacing="12">
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ToggleSwitch x:Name="ShareMailSwitch" Header="Mail" Toggled="SharingSwitch_Toggled" /><ToggleSwitch x:Name="ShareCalendarsSwitch" Grid.Column="1" Header="Calendars" Toggled="SharingSwitch_Toggled" /></Grid>
                                            <TextBlock x:Name="MissingConsentText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                                            <StackPanel x:Name="CalendarChoices" Spacing="8">
                                                <ComboBox x:Name="CalendarScope" HorizontalAlignment="Stretch" SelectionChanged="CalendarScope_SelectionChanged" AutomationProperties.Name="Calendar sharing scope"><ComboBoxItem Content="All current and future calendars" /><ComboBoxItem Content="Selected calendars only" /></ComboBox>
                                                <TextBlock x:Name="CalendarSelectionText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button Content="Choose individual calendars" Style="{StaticResource QuietButton}" Click="ChooseCalendarsButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="SharingSavedText" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel x:Name="SharingSaveActions" Orientation="Horizontal" Spacing="8"><Button x:Name="SaveSharingButton" Content="Save choices" Style="{StaticResource AccentButtonStyle}" Click="SaveSharingButton_Click" IsEnabled="False" /><Button x:Name="DiscardSharingButton" Content="Discard changes" Style="{StaticResource QuietButton}" Click="DiscardSharingButton_Click" Visibility="Collapsed" /></StackPanel>
                                    </StackPanel></Border>
                                </StackPanel>
                            </Grid>
                            <Expander x:Name="MailSearchPreferencesExpander" Header="Default mail search period" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Applies to every account when a mail search has no dates. Explicit search dates override this setting." Style="{StaticResource BodyText}" />
                                    <NumberBox x:Name="MailSearchLookbackDaysBox" Header="Days to look back" Width="200" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="7" ValidationMode="Disabled" IsEnabled="False" AutomationProperties.Name="Default mail search period in days" AutomationProperties.HelpText="Enter a whole number from 1 to 365. The default is 14 days. Explicit search dates override this setting." />
                                    <TextBlock Text="Longer periods take more time, make more requests and may hit your email provider's limits. The default is 14 days." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MailSearchPreferencesSavedText" Text="Loading the saved search period…" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel x:Name="MailSearchPreferencesActions" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SaveMailSearchPreferencesButton" Content="Save search period" Style="{StaticResource AccentButtonStyle}" Click="SaveMailSearchPreferencesButton_Click" IsEnabled="False" />
                                        <Button x:Name="DiscardMailSearchPreferencesButton" Content="Discard changes" Style="{StaticResource QuietButton}" Click="DiscardMailSearchPreferencesButton_Click" Visibility="Collapsed" />
                                        <Button x:Name="ReloadMailSearchPreferencesButton" Content="Retry loading" Style="{StaticResource QuietButton}" Click="ReloadMailSearchPreferencesButton_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <StackPanel Spacing="8"><TextBlock Text="Changes apply to future reads. Existing conversations keep what was already shared." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button Style="{StaticResource QuietButton}" Click="SharingInfoButton_Click"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE76C;" FontSize="12" /><TextBlock Text="What reaches your assistant" /></StackPanel></Button></StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="CodexPage" Spacing="20" Visibility="Collapsed">
                            <StackPanel Spacing="6"><TextBlock Text="Connect to Codex" Style="{StaticResource SectionTitle}" /><TextBlock Text="Make your shared accounts available in your conversations." Style="{StaticResource BodyText}" /></StackPanel>
                            <Border Style="{StaticResource SetupCard}" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="CodexStatusTitle" Text="Check your setup" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="CodexStatusText" Text="Check this device for the MailMeUp connection, then follow the next step. No mailbox content is read during setup." Style="{StaticResource BodyText}" />
                                    <StackPanel x:Name="CodexActions" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="InstallPluginButton" Content="Install local plugin" Click="InstallPluginButton_Click" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" IsEnabled="False" />
                                        <Button x:Name="CodexHelpButton" Content="Review next steps" Click="CodexHelpButton_Click" Visibility="Collapsed" />
                                        <Button x:Name="RefreshCodexButton" Content="Check setup" Click="RefreshCodexButton_Click" Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="CodexDetails" Header="Connection details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                                <StackPanel x:Name="CodexChecks" Spacing="4" />
                                <TextBlock x:Name="CodexCheckedText" Text="Not checked yet." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="CopyCodexResultsButton" Content="Copy setup results" Click="CopyCodexResultsButton_Click" Style="{StaticResource QuietButton}" Visibility="Collapsed" />
                            </StackPanel></Expander>
                            <Border Style="{StaticResource SetupCard}" Padding="16"><Grid x:Name="CodexSharingSummary" ColumnSpacing="12" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="CodexSharingActionColumn" Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock Text="Your sharing choices" FontWeight="SemiBold" /><TextBlock x:Name="CodexSharingText" Text="No accounts shared yet." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button x:Name="ReviewSharingButton" Grid.Column="1" Content="Review sharing →" Style="{StaticResource QuietButton}" Click="ReviewSharingButton_Click" /></Grid></Border>
                            <TextBlock Text="Configuration is not a connection test. No prompt is run, no mailbox is read, and no existing connection is removed by this check." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource QuietButton}" Click="ManualSetupButton_Click"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE76C;" FontSize="12" /><TextBlock Text="Manual setup (fallback)" TextWrapping="Wrap" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                </ContentControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Spacing="8" Margin="0,4,0,10">
                <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
                <Grid x:Name="Activity" ColumnSpacing="12" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ProgressRing Width="20" Height="20" IsActive="True" /><TextBlock x:Name="ActivityText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><Button Grid.Column="2" Content="Cancel" Click="CancelButton_Click" /></Grid>
            </StackPanel>
            <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="BackButton" Content="← Back" Click="BackButton_Click" /><TextBlock x:Name="PreviewLabel" Grid.Column="1" Text="Your choices stay on this device" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /><Button x:Name="NextButton" Grid.Column="2" Content="Get started →" HorizontalAlignment="Right" Padding="22,10" Click="NextButton_Click" Style="{StaticResource AccentButtonStyle}" /></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
